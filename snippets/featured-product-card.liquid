<div class="featured-product-card" data-product-id="{{ product.id }}">
  <div class="featured-product-card__image">
    {{ product.featured_image | image_url: width: 400 | image_tag }}
  </div>

  <h3 class="featured-product-card__title">
    {{ product.title }}
  </h3>

  <div class="featured-product-card__price">
    {{ product.price | money }}
  </div>

  <button
    class="featured-product-card__button"
    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
    type="button"
  >
    Add to cart
  </button>
</div>
